        .legend-line { width: 25px; height: 3px; }
        .legend-line.main { background: #64748b; }
        .legend-line.shortcut { border-top: 3px dashed #f59e0b; }
        .legend-line.active { background: #38bdf8; }

        .control-panel {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: space-between;
            align-items: flex-end;
            padding: 20px;
            border-radius: 12px;
            margin-top: 15px;
        }
