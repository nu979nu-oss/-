function updateTheme() {
    const themeChoice = document.getElementById('timeTheme').value;
    let isDay = (themeChoice === 'auto') ? (new Date().getHours() >= 6 && new Date().getHours() < 18) : (themeChoice === 'day');
    document.body.className = isDay ? 'theme-day' : 'theme-night';
    currentThemeMode = isDay ? 'day' : 'night';
    drawMap();
}

function setupSearchAutocomplete(inputId, suggestionsId) {
    const input = document.getElementById(inputId);
    const suggestionsBox = document.getElementById(suggestionsId);

    input.addEventListener('input', function() {
        const query = this.value.trim();
        suggestionsBox.innerHTML = '';
        if (!query) { suggestionsBox.style.display = 'none'; return; }

        const filtered = provinceNames.filter(p => p.includes(query));
        if (filtered.length === 0) { suggestionsBox.style.display = 'none'; return; }

        filtered.forEach(prov => {
            const item = document.createElement('div');
            item.textContent = prov;
            item.onclick = function() {
                input.value = prov;
                suggestionsBox.style.display = 'none';
                drawMap();
            };
            suggestionsBox.appendChild(item);
        });
        suggestionsBox.style.display = 'block';
    });

    document.addEventListener('click', function(e) {
        if (!input.contains(e.target) && !suggestionsBox.contains(e.target)) suggestionsBox.style.display = 'none';
    });
}

function swapLocations() {
    if (isAnimating) return;
    const s = document.getElementById('startInput');
    const e = document.getElementById('endInput');
    const temp = s.value; s.value = e.value; e.value = temp;
    drawMap();
}

// อัลกอริทึมค้นหาเส้นทางแบบแม่นยำ Dijkstra
function dijkstra(startNode, endNode, mode) {
    let distances = {};
    let prev = {};
    let edgeUsed = {};
    let unvisited = new Set(Object.keys(nodes));

    for (let node in nodes) {
        distances[node] = Infinity;
        prev[node] = null;
    }
    distances[startNode] = 0;

    while (unvisited.size > 0) {
        let currNode = null;
        for (let node of unvisited) {
            if (currNode === null || distances[node] < distances[currNode]) {
                currNode = node;
            }
        }

        if (currNode === endNode || distances[currNode] === Infinity) break;
        unvisited.delete(currNode);

        let neighbors = graph.filter(e => e.from === currNode || e.to === currNode);
        for (let edge of neighbors) {
            let neighbor = edge.from === currNode ? edge.to : edge.from;
            if (!unvisited.has(neighbor)) continue;

            let weight = 0;
            if (mode === 'time') {
                weight = edge.dist / edge.speed; // ทางหลวงหลักมักจะเร็วกว่า
            } else if (mode === 'shortcut') {
                weight = edge.dist; // เลือกเส้นทางสั้นที่สุด (รวมทางลัด)
            } else if (mode === 'cost') {
                weight = edge.cost + (edge.dist * 1.2);
            }

            let alt = distances[currNode] + weight;
            if (alt < distances[neighbor]) {
                distances[neighbor] = alt;
                prev[neighbor] = currNode;
                edgeUsed[neighbor] = edge;
            }
        }
    }

    let path = [];
    let pathEdges = [];
    let curr = endNode;
    while (curr) {
        path.unshift(curr);
        if (prev[curr]) pathEdges.unshift(edgeUsed[curr]);
        curr = prev[curr];
    }
    return { path, pathEdges };
}

function drawMap() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const isDay = currentThemeMode === 'day';
    const gridColor = isDay ? '#fde68a' : '#111827';
    const roadColor = isDay ? '#cbd5e1' : '#1f2937';
    const shortcutColor = isDay ? '#d97706' : '#f59e0b';
    const highlightPathColor = isDay ? '#2563eb' : '#38bdf8';
    const nodeDefault = isDay ? '#f59e0b' : '#374151';
    const nodeText = isDay ? '#78350f' : '#f9fafc';

    // วาด Grid
    ctx.strokeStyle = gridColor;
    ctx.lineWidth = 1;
    for (let i = 0; i < canvas.width; i += 30) { ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, canvas.height); ctx.stroke(); }
    for (let i = 0; i < canvas.height; i += 30) { ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(canvas.width, i); ctx.stroke(); }

    // วาดเส้นทางทั้งหมดในระบบ (แยกเส้นทางหลัก กับ เส้นทางลัด)
    graph.forEach(edge => {
        const u = nodes[edge.from];
        const v = nodes[edge.to];
        if (!u || !v) return;

        ctx.beginPath();
        ctx.moveTo(u.x, u.y);
        ctx.lineTo(v.x, v.y);

        if (edge.shortcut) {
            ctx.strokeStyle = shortcutColor;
            ctx.lineWidth = 2;
            ctx.setLineDash([4, 4]); // แสดงทางลัดเป็นเส้นประ
        } else {
            ctx.strokeStyle = roadColor;
            ctx.lineWidth = 2.5;
            ctx.setLineDash([]);
        }
        ctx.stroke();
        ctx.setLineDash([]);
    });

    // วาดเส้นทางที่เลือก (วิ่งตามแนวเส้นจริง ไม่ลอยข้าม)
    activeEdges.forEach(e => {
        const u = nodes[e.from];
        const v = nodes[e.to];

        ctx.beginPath();
        ctx.moveTo(u.x, u.y);
        ctx.lineTo(v.x, v.y);
        ctx.strokeStyle = highlightPathColor;
        ctx.lineWidth = 6;
        ctx.shadowColor = highlightPathColor;
        ctx.shadowBlur = 10;
        ctx.stroke();
        ctx.shadowBlur = 0;

        // วาดเส้นประซ้อนวิ่งตามทาง
        ctx.beginPath();
        ctx.moveTo(u.x, u.y);
        ctx.lineTo(v.x, v.y);
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 6]);
        ctx.lineDashOffset = -dashOffset;
        ctx.stroke();
        ctx.setLineDash([]);
    });

    const startProv = document.getElementById('startInput').value.trim();
    const endProv = document.getElementById('endInput').value.trim();

    // วาดจุดหมุดจังหวัด
    for (let key in nodes) {
        const node = nodes[key];
        const isInPath = activeVisitedNodes.includes(key);

        ctx.beginPath();
        ctx.arc(node.x, node.y, (key === startProv || key === endProv) ? 8 : (isInPath ? 5 : 3.5), 0, Math.PI * 2);
        ctx.fillStyle = key === startProv ? '#10b981' : (key === endProv ? '#ef4444' : (isInPath ? highlightPathColor : nodeDefault));
        ctx.fill();

        if (isInPath || key === startProv || key === endProv) {
            ctx.fillStyle = nodeText;
            ctx.font = 'bold 11px Kanit';
            ctx.fillText(key, node.x - 12, node.y - 10);
        }
    }

    // วาดพาหนะ
    if (vehiclePosition) {
        const vehicleIcon = document.getElementById('vehicleType').value;
        ctx.font = '22px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(vehicleIcon, vehiclePosition.x, vehiclePosition.y);
    }
}

function calculateRoute() {
    if (isAnimating) return;

    const startNode = document.getElementById('startInput').value.trim();
    const endNode = document.getElementById('endInput').value.trim();
    const optType = document.getElementById('optimizeType').value;

    if (!startNode || !endNode || !nodes[startNode] || !nodes[endNode] || startNode === endNode) {
        alert('กรุณาเลือกจังหวัดต้นทางและปลายทางให้ถูกต้องครับ');
        return;
    }

    resetState();
    const routeData = dijkstra(startNode, endNode, optType);
    activePath = routeData.path;

    if (activePath.length <= 1) {
        document.getElementById('routeStatus').innerHTML = '<div class="placeholder-text" style="color: #ef4444;">❌ ไม่พบเส้นทางเชื่อมต่อระหว่างสองจังหวัดนี้</div>';
        return;
    }

    isAnimating = true;
    toggleButtons(true);

    let totalDist = 0;
    let totalCost = 0;
    let totalHoursFloat = 0;
    const vehicle = document.getElementById('vehicleType').value;
    const vehicleSpeedFactor = (vehicle === '🛵') ? 0.85 : 1.0;

    for (let edge of routeData.pathEdges) {
        totalDist += edge.dist;
        totalCost += edge.cost;
        totalHoursFloat += edge.dist / (edge.speed * vehicleSpeedFactor);
    }

    if (vehicle === '🛵') totalCost = Math.round(totalCost * 0.4);

    let hours = Math.floor(totalHoursFloat);
    let mins = Math.round((totalHoursFloat - hours) * 60);

    document.getElementById('valDist').innerText = `${totalDist} กม.`;
    document.getElementById('valCost').innerText = `${totalCost.toLocaleString()} บาท`;
    document.getElementById('valTime').innerText = `${hours} ชม. ${mins} นาที`;

    animateSegment(0, routeData.pathEdges);
}

function animateSegment(index, edgesList) {
    if (index >= edgesList.length) {
        vehiclePosition = null;
        isAnimating = false;
        toggleButtons(false);
        drawMap();

        const optType = document.getElementById('optimizeType').value;
        let optText = optType === 'shortcut' ? '🛣️ ทางลัด' : (optType === 'time' ? '⚡ เร็วที่สุด' : '💰 ประหยัดสุด');

        let flowHtml = activePath.map((p, idx) => {
            let className = 'step-item';
            let icon = '📍';
            if (idx === 0) { className += ' start'; icon = '🛫'; }
            else if (idx === activePath.length - 1) { className += ' end'; icon = '🏁'; }
            let arrow = (idx < activePath.length - 1) ? '<span style="color:#64748b;">➔</span>' : '';
            return `<div class="${className}">${icon} ${p}</div> ${arrow}`;
        }).join(' ');

        document.getElementById('routeStatus').innerHTML = `
            <div class="route-card-header">
                <div><b>🎉 วาดเส้นทางเรียบร้อยแล้ว</b></div>
                <div style="font-size:12px; font-weight:bold; color:#38bdf8;">${optText}</div>
            </div>
            <div class="route-flow-container">${flowHtml}</div>
        `;
        return;
    }

    const currentEdge = edgesList[index];
    const uName = activePath[index];
    const vName = activePath[index + 1];
    const u = nodes[uName];
    const v = nodes[vName];

    if (!activeVisitedNodes.includes(uName)) activeVisitedNodes.push(uName);

    let frames = 15;
    let currentFrame = 0;

    function step() {
        currentFrame++;
        dashOffset = (dashOffset + 1.5) % 12;
        let progress = currentFrame / frames;

        vehiclePosition = {
            x: u.x + (v.x - u.x) * progress,
            y: u.y + (v.y - u.y) * progress
        };

        drawMap();

        if (currentFrame < frames) {
            requestAnimationFrame(step);
        } else {
            activeEdges.push({ from: uName, to: vName });
            if (!activeVisitedNodes.includes(vName)) activeVisitedNodes.push(vName);
            animateSegment(index + 1, edgesList);
        }
    }

    step();
}

function toggleButtons(disabled) {
    document.querySelectorAll('.btn-action, .btn-swap').forEach(btn => btn.disabled = disabled);
}

function resetState() {
    activePath = [];
    activeEdges = [];
    activeVisitedNodes = [];
    vehiclePosition = null;
}

function resetMap() {
    if (isAnimating) return;
    resetState();
    document.getElementById('startInput').value = '';
    document.getElementById('endInput').value = '';
    document.getElementById('valDist').innerText = '0 กม.';
    document.getElementById('valCost').innerText = '0 บาท';
    document.getElementById('valTime').innerText = '0 ชม. 0 นาที';
    document.getElementById('routeStatus').innerHTML = `
        <div class="placeholder-text">📌 เลือก <b>ต้นทาง, ปลายทาง, รูปแบบการเดินทาง</b> แล้วกดปุ่ม <b>"ค้นหาเส้นทาง"</b></div>
    `;
    drawMap();
}

