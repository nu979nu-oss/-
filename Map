                <input type="text" id="startInput" placeholder="พิมพ์ชื่อจังหวัดต้นทาง..." autocomplete="off" oninput="drawMap()">
                <div id="startSuggestions" class="suggestions-list"></div>
            </div>

            <div style="align-self: flex-end;">
                <button type="button" class="btn-swap" onclick="swapLocations()" title="สลับต้นทาง-ปลายทาง">🔄</button>
            </div>

            <div class="search-box-wrapper">
                <label for="endInput">🏁 ตำแหน่งที่จะไป (ปลายทาง):</label>
                <input type="text" id="endInput" placeholder="พิมพ์ชื่อจังหวัดปลายทาง..." autocomplete="off" oninput="drawMap()">
                <div id="endSuggestions" class="suggestions-list"></div>
            </div>

            <div style="min-width: 130px;">
                <label for="vehicleType">🛵 พาหนะเดินทาง:</label>
                <select id="vehicleType" onchange="drawMap()">
                    <option value="🚗">🚗 รถยนต์</option>
                    <option value="🛵">🛵 มอเตอร์ไซค์</option>
                </select>
            </div>

            <div style="min-width: 180px;">
                <label for="optimizeType">🎯 เงื่อนไขเส้นทาง:</label>
                <select id="optimizeType">
                    <option value="shortcut">🛣️ ทางลัด (ระยะทางสั้นที่สุด)</option>
                    <option value="time">⚡ เส้นทางเร็วที่สุด (ทางหลวงหลัก)</option>
                    <option value="cost">💰 ประหยัดเงินที่สุด</option>
                </select>
            </div>

            <div style="min-width: 140px;">
                <label for="timeTheme">🌤️ บรรยากาศ:</label>
                <select id="timeTheme" onchange="updateTheme()">
                    <option value="auto">⏰ อัตโนมัติ</option>
                    <option value="day">☀️ ตอนเช้า</option>
                    <option value="night">🌙 ตอนกลางคืน</option>
                </select>
            </div>
        </div>

        <div class="btn-group">
            <button class="btn-action" onclick="calculateRoute()">🧭 ค้นหาเส้นทาง</button>
            <button class="btn-action btn-reset" onclick="resetMap()">🔄 รีเซ็ต</button>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="lbl">ระยะทางรวมทั้งสิ้น</div>
            <div class="val" id="valDist">0 กม.</div>
        </div>
        <div class="stat-card cost">
            <div class="lbl">ประเมินค่าเดินทาง</div>
            <div class="val" id="valCost">0 บาท</div>
        </div>
        <div class="stat-card time">
            <div class="lbl">เวลาเดินทางโดยประมาณ</div>
            <div class="val" id="valTime">0 ชม. 0 นาที</div>
        </div>
    </div>

    <div class="route-details-card" id="routeStatus">
        <div class="placeholder-text">
