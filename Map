        label { display: block; font-size: 13px; color: #9ca3af; margin-bottom: 6px; font-weight: 600; }
        input[type="text"], select, button {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            outline: none;
            width: 100%;
        }
        .suggestions-list {
            position: absolute;
            top: 100%; left: 0; right: 0;
            border-radius: 8px;
            max-height: 180px;
            overflow-y: auto;
            z-index: 100;
            display: none;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            margin-top: 4px;
        }
        .suggestions-list div { padding: 8px 12px; cursor: pointer; font-size: 13px; }
        .btn-group { display: flex; gap: 8px; }
        button {
            width: auto;
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: white;
            font-weight: 600;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }
        body.theme-day button.btn-action {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }
        button:hover { opacity: 0.9; transform: translateY(-1px); }
        button:disabled { background: #9ca3af !important; cursor: not-allowed; transform: none; box-shadow: none !important; }
        .btn-swap { background: #374151; color: #38bdf8; border: 1px solid #4b5563; padding: 10px; border-radius: 8px; cursor: pointer; }
        .btn-reset { background: #4b5563 !important; color: #fff !important; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        .stat-card {
            padding: 15px;
            border-radius: 10px;
